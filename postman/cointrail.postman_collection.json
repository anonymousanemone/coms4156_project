{
  "info": {
    "name": "CoinTrail",
    "description": "API tests for the CoinTrail service. The expected numbers assume the database holds the test data in src/test/resources/test_data. Set baseUrl and apiKey to point at another server or client.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "apiKey",
      "value": "540ba996-2ae9-4f72-8b4f-014b463bc4d7"
    }
  ],
  "item": [
    {
      "name": "Get statistics",
      "description": "Operation 4: counts grouped by up to two dimensions, and museum/donor summaries.",
      "item": [
        {
          "name": "Valid requests",
          "item": [
            {
              "name": "All objects, no grouping",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/v1/statistics",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "v1",
                    "statistics"
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                      "const body = pm.response.json();",
                      "pm.test(\"Metric defaults to objects\", () => pm.expect(body.metric).to.eql(\"objects\"));",
                      "pm.test(\"No buckets without groupBy\", () => pm.expect(body.buckets).to.be.empty);",
                      "pm.test(\"Counts every coin\", () => pm.expect(body.total).to.eql(1405));",
                      "pm.test(\"Nothing excluded\", () => {",
                      "    pm.expect(body.excludedMissingYear).to.eql(0);",
                      "    pm.expect(body.excludedUnknownType).to.eql(0);",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Objects by decade and type",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/v1/statistics?metric=objects&groupBy=decade&groupBy=type",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "v1",
                    "statistics"
                  ],
                  "query": [
                    {
                      "key": "metric",
                      "value": "objects"
                    },
                    {
                      "key": "groupBy",
                      "value": "decade"
                    },
                    {
                      "key": "groupBy",
                      "value": "type"
                    }
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                      "const body = pm.response.json();",
                      "pm.test(\"Echoes the group-by\", () => pm.expect(body.groupBy).to.eql([\"decade\", \"type\"]));",
                      "pm.test(\"Excludes coins missing a year or type\", () => {",
                      "    pm.expect(body.excludedMissingYear).to.eql(20);",
                      "    pm.expect(body.excludedUnknownType).to.eql(21);",
                      "    pm.expect(body.total).to.eql(1383);",
                      "});",
                      "pm.test(\"Buckets add up to the total\", () => {",
                      "    const sum = body.buckets.reduce((s, b) => s + b.value, 0);",
                      "    pm.expect(sum).to.eql(body.total);",
                      "});",
                      "pm.test(\"1890s gifts\", () => {",
                      "    const b = body.buckets.find(b => b.groups.decade === 1890 && b.groups.type === \"GIFT\");",
                      "    pm.expect(b.value).to.eql(113);",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Acquisitions by type",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/v1/statistics?metric=acquisitions&groupBy=type",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "v1",
                    "statistics"
                  ],
                  "query": [
                    {
                      "key": "metric",
                      "value": "acquisitions"
                    },
                    {
                      "key": "groupBy",
                      "value": "type"
                    }
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                      "const body = pm.response.json();",
                      "pm.test(\"Counts distinct gift acquisitions\", () => {",
                      "    const gift = body.buckets.find(b => b.groups.type === \"GIFT\");",
                      "    pm.expect(gift.value).to.eql(80);",
                      "});"
                    ]
                  }
                }
              ]
            },
