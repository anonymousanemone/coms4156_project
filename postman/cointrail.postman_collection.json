            },
            {
              "name": "Museum summary",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/v1/statistics/museums/MMA",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "v1",
                    "statistics",
                    "museums",
                    "MMA"
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                      "const body = pm.response.json();",
                      "pm.test(\"Totals\", () => {",
                      "    pm.expect(body.name).to.eql(\"The Metropolitan Museum of Art\");",
                      "    pm.expect(body.totalObjects).to.eql(1405);",
                      "    pm.expect(body.totalAcquisitions).to.eql(95);",
                      "    pm.expect(body.distinctDonors).to.eql(65);",
                      "});",
                      "pm.test(\"Objects by type\", () => pm.expect(body.objectsByType).to.eql({EXCAVATION: 678, GIFT: 496, PURCHASE: 210, UNKNOWN: 21}));",
                      "pm.test(\"Largest acquisitions, biggest first\", () => {",
                      "    pm.expect(body.largestAcquisitions).to.have.lengthOf(5);",
                      "    pm.expect(body.largestAcquisitions[0].objects).to.eql(525);",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Donor summary",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/v1/statistics/donors/f7863357-6dd5-41a0-ac9e-7c6653ca767f",
